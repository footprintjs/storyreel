    },
    "./transitions": {
      "types": "./types/sub/transitions.d.ts",
      "default": "./src/transitions.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "storyreel": "src/cli.mjs"
  },
  "files": [
    "src",
    "plugin",
    "types",
    "themes",
    "fonts",
    "examples/*.mjs",
    "examples/*/*.mjs",
    "examples/*/*.json",
    "examples/*/*.ts",
    "examples/*/strings/*.json",
    "README.md",
    "CHANGELOG.md",
    "BACKLOG.md",
    "LICENSE"

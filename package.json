    "footprintjs": "^9.27.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

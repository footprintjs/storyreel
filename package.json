    },
    "./sound": "./src/sound.mjs",
    "./pen": "./src/pen.mjs",
    "./theme": {
      "types": "./types/sub/theme.d.ts",
      "default": "./src/theme.mjs"
    },
    "./ground": "./src/ground.mjs",
    "./film": {
      "types": "./types/sub/film.d.ts",
      "default": "./src/film.mjs"
    },
    "./render": {
      "types": "./types/sub/render.d.ts",
      "default": "./src/render.mjs"
    },
    "./segments": {
      "types": "./types/sub/segments.d.ts",
      "default": "./src/segments.mjs"
    },
    "./pipeline": {
      "types": "./types/sub/pipeline.d.ts",
      "default": "./src/pipeline.mjs"
    },
    "./approval": {
      "types": "./types/sub/approval.d.ts",

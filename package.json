{
  "name": "footprint-storyreel",
  "version": "0.9.0",
  "description": "Teaching films from a storyboard and a recipe: every drawing tied to a spoken phrase, one seekable timeline, pixel-pinned frames, director notes, a local preview studio, and a making-of record for every film.",
  "keywords": [
    "video",
    "animation",
    "explainer",
    "teaching",
    "narration",
    "whiteboard",
    "storyboard",
    "canvas",
    "footprintjs",
    "captions",
    "transitions",
    "shorts"
  ],
  "homepage": "https://github.com/footprintjs/storyreel#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/storyreel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/storyreel.git"
  },
  "license": "MIT",
  "author": "Sanjay Krishna Anbalagan",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./clock": {
      "types": "./types/sub/clock.d.ts",
      "default": "./src/clock.mjs"
    },
    "./pacing": {
      "types": "./types/sub/pacing.d.ts",
